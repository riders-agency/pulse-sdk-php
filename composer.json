{
  "name": "riders-agency/pulse-sdk",
  "version": "0.1.0",
  "description": "Reviewed JSON subset of Pulse API v1: authentication, tasks and AI proposals. Configure your own server origin.",
  "keywords": [
    "openapitools",
    "openapi-generator",
    "openapi",
    "php",
    "sdk",
    "rest",
    "api"
  ],
  "homepage": "https://github.com/riders-agency/pulse-sdk-php",
  "license": "MIT",
  "authors": [
    {
      "name": "Riders Agency",
      "email": "hello@riders.agency"
    }
  ],
  "require": {
    "php": "^8.1",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "guzzlehttp/guzzle": "^7.3",
    "guzzlehttp/psr7": "^1.7 || ^2.0"
  },
  "autoload": {
    "psr-4": {
      "Riders\\Pulse\\": "lib/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Riders\\Pulse\\Laravel\\PulseServiceProvider"
      ]
    }
  },
  "suggest": {
    "laravel/framework": "Laravel request-scoped provider",
    "symfony/framework-bundle": "Symfony request factory and service configuration"
  }
}
